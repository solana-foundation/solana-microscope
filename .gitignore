.claude/settings.local.json
.remember/
.env
# per-deployment config; start from microscope.toml.example
/microscope.toml
/.microscope-state/
target/
node_modules/
# generated by `just generate`
/crates/program-decoder/
/crates/squads-v3-decoder/
/crates/squads-v4-decoder/
/crates/squads-smart-account-decoder/
# generated from microscope.toml when Grafana provisioning starts
/grafana/dashboards/
/grafana/provisioning/alerting/

# Terraform working directories, local inputs, and state (which may contain secrets)
**/.terraform/*
**/.terraform-*/
# the IDL a deployment indexes, kept beside the tfvars that name it
/infra/*/idl/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exported Grafana Cloud provisioning is deployment-specific; regenerate with
# scripts/export-grafana-cloud.sh and keep it out of the template repo.
/dashboards/
/alert-rules/
/notification-policies/
tfplan
.local/
._*
*.tfvars.json
