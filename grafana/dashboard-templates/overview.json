{
  "title": "Microscope Overview",
  "uid": "microscope-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(microscope_transactions_total[5m]))",
          "legendFormat": "tx/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(microscope_errors_total[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Instructions by type",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (instruction) (rate(microscope_instructions_total[5m]))",
          "legendFormat": "{{instruction}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Seconds since last decoded activity",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "time() - microscope_last_event_unixtime",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 5,
      "title": "Indexer up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"microscope-indexer\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 7,
      "title": "Squads multisig activity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (version, action, failed) (rate(microscope_multisig_activity_total[5m]))",
          "legendFormat": "{{version}} {{action}} failed={{failed}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Decoded program events",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service_name=\"microscope-indexer\"} |= \"\\\"kind\\\":\\\"program_event\\\"\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Squads multisig activity details",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 44 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service_name=\"microscope-indexer\"} |= \"\\\"kind\\\":\\\"multisig_activity\\\"\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
