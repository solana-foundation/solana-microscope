# Transaction datasource (never commit the real .env; use a secret manager in shared environments)
# Yellowstone is the default; leave these empty in RPC mode.
GEYSER_URL=https://your-yellowstone-endpoint:443
GEYSER_X_TOKEN=your-yellowstone-token
# Required in RPC mode and by backfill. In Yellowstone mode, setting it enables automatic gap recovery.
RPC_URL=https://your-solana-rpc-endpoint

# How long the Yellowstone endpoint may keep failing its GetVersion probe before
# /readyz reports unready; defaults to 90 seconds. Set 0 to leave readiness blind
# to the endpoint.
# MICROSCOPE_STREAM_STALE_AFTER_SECONDS=90

# Inject through your secret manager in shared environments.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Compose project name; Alloy uses it to collect only this stack's logs.
# Compose v2.9+ fills it in automatically when unset (the directory-derived
# project name); set it only to pin the project name explicitly. Two stacks
# on one host must not share a value.
# COMPOSE_PROJECT_NAME=solana-microscope

# How long Prometheus keeps metrics; defaults to 30d, matching Loki's
# retention_period. Accepts any Prometheus duration (for example 15d, 720h).
# PROMETHEUS_RETENTION=30d

# Required only when an alert selects the corresponding channel.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGERDUTY_INTEGRATION_KEY=

# Grafana Cloud mode only (docker-compose.cloud.yml). Push endpoints and
# tenant user IDs are shown in your Grafana Cloud portal per datasource; the
# token is an access policy token with logs:write and metrics:write. The
# deployment name namespaces streams in a shared stack, it does not isolate
# them: any write token for the stack can write under any deployment name.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_TOKEN=
MICROSCOPE_DEPLOYMENT=
MICROSCOPE_ENV=prd
